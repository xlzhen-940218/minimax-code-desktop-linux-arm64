{
  "name": "@mavis/config",
  "version": "0.2.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data-dir": {
      "types": "./src/data-dir.ts",
      "import": "./dist/data-dir.js",
      "default": "./dist/data-dir.js"
    },
    "./sandbox-settings": {
      "types": "./src/sandbox-settings.ts",
      "import": "./dist/sandbox-settings.js",
      "default": "./dist/sandbox-settings.js"
    }
  },
  "dependencies": {
    "@mavis/shared": "file:../shared",
    "js-yaml": "4.1.1",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4",
    "@types/node": "20.19.39",
    "@types/proper-lockfile": "^4",
    "typescript": "^5"
  }
}
