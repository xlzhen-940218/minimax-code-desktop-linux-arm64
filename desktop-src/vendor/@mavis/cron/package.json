{
  "name": "@mavis/cron",
  "version": "0.2.1",
  "description": "Cron task scheduling/execution capability for Mavis agent runtimes. Depends only on @mavis/agent-core primitives; never imports runtime packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@mavis/agent-core": "file:../agent-core",
    "@mavis/shared": "file:../shared"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "typescript": "^5",
    "vitest": "^2"
  }
}
