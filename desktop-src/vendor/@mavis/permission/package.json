{
  "name": "@mavis/permission",
  "version": "0.2.1",
  "description": "Tool-call permission decision engine for Mavis agents; host integration is injected and the package never imports runtime packages.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./plugin-hook-permission-port": {
      "types": "./src/plugin-hook-permission-port.ts",
      "import": "./dist/plugin-hook-permission-port.js"
    }
  },
  "dependencies": {
    "@mavis/agent-core": "file:../agent-core"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "typescript": "^5",
    "vitest": "^2"
  }
}
